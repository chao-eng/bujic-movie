# ==========================================
# Bujic Movie Root .Gitignore Configuration
# ==========================================

# 1. OS specific files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# 2. Project References & Agent directories
reference/
.agents/
# skills/ 为项目根级技能目录，仅放行需入库的 bujic-subtitle Skill（唯一副本，见 doc/影视字幕Agent能力PRD.md v0.3 §6.6）
skills/*
!skills/bujic-subtitle/

# 3. Editor & IDE directories
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# 4. Go Backend Artifacts
# Compiled binaries and executables
app/bujic-movie
bujic-movie
*.exe
*.exe~
*.dll
*.so
*.dylib

# Database and runtime data files
app/data/
# 只忽略根目录的 data/：写成 `data/` 会连带忽略 web/src/data/（官网的导航数据）。
/data/
*.db
*.db-journal
*.sqlite
*.sqlite3
*.log

# Local custom configuration files containing TMDB API keys and credentials
app/configs/config.yaml
configs/config.yaml

# 5. Frontend Vue 3 + Vite + TypeScript Artifacts
# Dependency directories
node_modules/
app/web/node_modules/

# Production build output (managed by go:embed)
app/dist/
dist/

# Logs and runtime caches
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.eslintcache
.stylelintcache
.vite
.npm

# Local environment variables
.env.local
.env.*.local
# 本地工具产物
.openchamber/

# 介绍视频工程（huashu-motion 剪辑缓存、渲染产物，全部为本地产物）
/film/

# 前端锁文件必须进版本库：Docker 构建用 npm ci 依赖它锁定依赖版本。
# （全局 gitignore 忽略了 package-lock.json，这里显式放行。）
!app/web/package-lock.json
# 官网（web/）同样用 npm ci 构建。
!web/package-lock.json
