{
  "manifest_version": 3,
  "name": "Bujic Movie Cookie 导入",
  "version": "1.3.0",
  "description": "从当前 Bujic Movie 页面复用登录状态，把已通过 Cloudflare 验证的 Cookie 与 User-Agent 导入回去。",
  "permissions": [
    "cookies",
    "activeTab",
    "scripting",
    "storage",
    "webRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "导入到 Bujic Movie",
    "default_popup": "popup.html"
  }
}
