---
import ThemeToggle from './ThemeToggle.astro'
import { Github, Menu, X, Play } from 'lucide-vue-next'

const path = Astro.url.pathname

const links = [
  { label: '能力', href: '/#features', match: () => false },
  { label: '界面预览', href: '/#preview', match: () => false },
  { label: '部署', href: '/docs/deploy/', match: () => path === '/docs/deploy/' },
  {
    label: '文档',
    href: '/docs/',
    match: () => path.startsWith('/docs') && path !== '/docs/deploy/' && path !== '/docs/faq/',
  },
  { label: '常见问题', href: '/docs/faq/', match: () => path === '/docs/faq/' },
]

const repo = 'https://github.com/chao-eng/bujic-movie'
---

<header class="bg-background/85 border-border/70 sticky top-0 z-40 border-b backdrop-blur-xl">
  <div class="mx-auto flex h-14 max-w-7xl items-center gap-3 px-4 sm:px-6">
    <a href="/" class="flex shrink-0 items-center gap-2" aria-label="布吉影库首页">
      <img src="/favicon.png" alt="" class="bg-muted ring-border size-7 rounded ring-1" width="28" height="28" />
      <span class="text-primary text-[1.05rem] font-bold tracking-wide">布吉影库</span>
      <span class="text-muted-foreground hidden text-xs sm:inline">Bujic Movie</span>
    </a>

    <nav class="ml-4 hidden items-center gap-1 md:flex" aria-label="主导航">
      {
        links.map((link) => (
          <a
            href={link.href}
            class:list={[
              'rounded-lg px-2.5 py-1.5 text-sm transition-colors',
              link.match()
                ? 'text-foreground bg-muted font-medium'
                : 'text-muted-foreground hover:text-foreground hover:bg-muted/60',
            ]}
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="ml-auto flex items-center gap-1.5">
      <ThemeToggle />
      <a
        href={repo}
        target="_blank"
        rel="noreferrer"
        class="text-muted-foreground hover:text-foreground hover:bg-muted hidden size-8 items-center justify-center rounded-lg transition-colors sm:inline-flex"
        aria-label="GitHub 仓库"
      >
        <Github class="size-4" />
      </a>
      <a
        href="/docs/deploy/"
        class="bg-primary text-primary-foreground hover:bg-primary/90 hidden items-center gap-1.5 rounded-lg px-3 py-1.5 text-sm font-medium transition-colors sm:inline-flex"
      >
        <Play class="size-3.5" />
        开始部署
      </a>
      <button
        type="button"
        id="nav-toggle"
        class="text-muted-foreground hover:text-foreground hover:bg-muted inline-flex size-8 items-center justify-center rounded-lg transition-colors md:hidden"
        aria-label="打开菜单"
        aria-expanded="false"
      >
        <Menu class="size-4" data-menu-icon="open" />
        <X class="hidden size-4" data-menu-icon="close" />
      </button>
    </div>
  </div>

  <div id="mobile-nav" class="border-border/70 hidden border-t md:hidden">
    <nav class="mx-auto flex max-w-7xl flex-col gap-0.5 px-4 py-3" aria-label="移动导航">
      {
        links.map((link) => (
          <a
            href={link.href}
            class="text-muted-foreground hover:bg-muted hover:text-foreground rounded-lg px-3 py-2 text-sm transition-colors"
          >
            {link.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('nav-toggle')
  const menu = document.getElementById('mobile-nav')

  toggle?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden') === false
    toggle.setAttribute('aria-expanded', String(open))
    toggle.setAttribute('aria-label', open ? '关闭菜单' : '打开菜单')
    toggle.querySelector<HTMLElement>('[data-menu-icon="open"]')?.classList.toggle('hidden', open)
    toggle.querySelector<HTMLElement>('[data-menu-icon="close"]')?.classList.toggle('hidden', !open)
  })
</script>
