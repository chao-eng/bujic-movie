---
import BaseLayout from '@/layouts/BaseLayout.astro'
import { ArrowLeft, SearchX } from 'lucide-vue-next'
---

<BaseLayout title="页面不存在 · 布吉影库" description="这个页面还没有写，或者链接已经过期。">
  <div class="mx-auto flex max-w-2xl flex-col items-center px-4 py-24 text-center">
    <div class="bg-muted text-muted-foreground flex size-14 items-center justify-center rounded-xl">
      <SearchX class="size-6" />
    </div>
    <h1 class="mt-6 text-2xl font-bold tracking-tight">这个页面不存在</h1>
    <p class="text-muted-foreground mt-2 text-sm leading-6">
      链接可能已经过期，或者页面还没写。文档目录在左侧（手机上是顶部菜单）。
    </p>
    <div class="mt-6 flex flex-col gap-2 sm:flex-row">
      <a
        href="/docs/"
        class="bg-primary text-primary-foreground hover:bg-primary/90 inline-flex h-9 items-center gap-2 rounded-lg px-4 text-sm font-medium transition-colors"
      >
        回到文档首页
      </a>
      <a
        href="/"
        class="ring-foreground/15 hover:bg-muted/60 inline-flex h-9 items-center gap-2 rounded-lg px-4 text-sm font-medium ring-1 transition-colors"
      >
        <ArrowLeft class="size-3.5" /> 返回首页
      </a>
    </div>
  </div>
</BaseLayout>
