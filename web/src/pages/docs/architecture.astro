        <tr><td>GET</td><td><code>/api/v1/logs/stream</code></td><td>SSE 日志流（支持 Last-Event-ID 续传）</td></tr>
        <tr><td>GET</td><td><code>/api/v1/logs/recent</code></td><td>最近日志快照</td></tr>
        <tr><td>POST</td><td><code>/api/v1/scrape</code></td><td>提交刮削任务</td></tr>
